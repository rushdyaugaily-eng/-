.default-media-grid { display: grid; grid-template-columns: 260px; grid-template-rows: 240px; gap: 8px; margin-top: 8px; margin-bottom: 8px; }

.default-media-grid.vcard-layout { grid-template-columns: minmax(260px, 320px); grid-template-rows: auto; }

.outbound-message .default-media-grid { justify-content: end; }

.media-grid-item { min-height: min(4vw, 126px); min-width: min(4vw, 126px); max-width: 100%; max-height: 100%; position: relative; }

.media-grid-item:hover { filter: brightness(75%); }

.media-grid-item .more-to-show-overlay { position: absolute; inset: 0px; background: rgba(0, 0, 0, 0.6); color: rgb(255, 255, 255); font-size: 18px; text-align: center; line-height: 18px; padding-top: calc(50% - 16px); border-radius: 6px; pointer-events: none; }

.media-grid-item .more-to-show-overlay span { font-size: 18px; }

.media-grid-item .mediaContentWrapper { width: 100%; height: 100%; overflow: hidden; border-radius: 6px; }

.media-grid-item .mediaContentWrapper.hasFailed { background: rgb(245, 247, 248); }

.media-grid-item .mediaContentWrapper.hasFailed svg { max-width: 60%; max-height: 60%; }

.media-grid-item .hover-menu { z-index: 999; }

.media-grid-item img { width: 100%; height: 100%; object-fit: cover; }

.media-grid-0 { display: none; }

.media-grid-1 { grid-template-columns: min(8vw, 260px); }

.media-grid-1, .media-grid-2 { grid-template-rows: min(8vw, 260px); }

.media-grid-2, .media-grid-3 { grid-template-columns: min(8vw, 260px) min(8vw, 260px); }

.media-grid-3 { grid-template-rows: min(4vw, 126px) min(4vw, 126px); }

.media-grid-3 .item-1 { grid-row: 1 / span 2; }

.media-grid-4 { grid-template-rows: min(4vw, 126px) min(4vw, 126px); grid-template-columns: min(8vw, 260px) min(4vw, 126px) min(4vw, 126px); }

.media-grid-4 .item-1 { grid-row: 1 / span 2; }

.media-grid-4 .item-2 { grid-column: 2 / span 2; }

.media-grid-5 { grid-template-rows: min(4vw, 126px) min(4vw, 126px); grid-template-columns: min(8vw, 260px) min(4vw, 126px) min(4vw, 126px); }

.media-grid-5 .item-1 { grid-row: 1 / span 2; }

.mediaContentImageBtn { border: 0px; background: none; padding: 0px; cursor: pointer; display: block; width: 100%; height: 100%; }

.mediaLoaderWrapper { background-color: rgb(245, 247, 248); border-radius: 6px; text-align: center; height: 100%; width: 100%; }

.mediaLoaderSpinner { position: absolute; left: 50%; top: 50%; margin-top: -18px; margin-left: -18px; }

.mediaContentRetryImageBtn { width: 100%; height: inherit; }

.outbound-message .mediaFailToLoad { text-align: right; }

.generic-file-thumb { overflow: hidden; background-color: rgb(245, 247, 248); border-radius: 1rem; height: 100%; width: 100%; text-align: center; font-size: 14px; line-height: 1.25em; padding: 5px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; }

.generic-file-thumb:hover { background-color: rgba(237, 241, 241, 0.79); }

@media (max-width: 768px) {
  .media-grid-1 { grid-template-columns: min(20vw, 260px); }
  .media-grid-1, .media-grid-2 { grid-template-rows: min(20vw, 260px); }
  .media-grid-2, .media-grid-3 { grid-template-columns: repeat(2, min(20vw, 260px)); }
  .media-grid-3 { grid-template-rows: min(10vw, 126px) min(10vw, 126px); }
  .media-grid-4, .media-grid-5 { grid-template-rows: repeat(2, min(10vw, 126px)); grid-template-columns: min(20vw, 260px) repeat(2, min(10vw, 126px)); }
  .default-media-grid.vcard-layout { grid-template-columns: minmax(200px, 75vw); grid-template-rows: auto; }
}

