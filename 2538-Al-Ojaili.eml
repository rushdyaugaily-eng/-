.AllAiroPlansFeatures-listItem { display: flex; flex-direction: column; }

.AllAiroPlansFeatures-listItem p { margin: 8px 0px; }

.AllAiroPlansFeatures-listItemIcon { display: inline-flex; height: 20px; width: 20px; }

.AllAiroPlansFeatures-mobile { gap: 24px; margin: 0px 16px; padding: 24px; }

.AllAiroPlansFeatures-mobile .AllAiroPlansFeatures-list { grid-template-columns: repeat(2, minmax(0px, 1fr)); }

@media screen and (max-width: 768px) {
  .AllAiroPlansFeatures-desktop { margin: 0px 16px; }
  .AllAiroPlansFeatures-desktop .AllAiroPlansFeatures-list { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
}

