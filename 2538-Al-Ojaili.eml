@media (max-width: 520px) {
  .skeleton__container--mobile { grid-template-columns: unset !important; grid-template-rows: unset !important; }
  .skeleton__container--mobile .skeleton__blank { grid-area: span 1 / span 1 !important; }
  .skeleton__container--mobile .skeleton__block { grid-area: span 1 / span 1 !important; }
  .skeleton__container--mobile .skeleton__text { grid-area: span 1 / span 1 !important; }
}

.skeleton__container::before { position: absolute; inset: 0px 0px 0px 50%; z-index: 1; width: 500%; margin-left: -250%; pointer-events: none; content: " "; background: linear-gradient(to right, rgba(255, 255, 255, 0) 46%, rgba(255, 255, 255, 0.35) 50%, rgba(255, 255, 255, 0) 54%) 50% 50%; animation: 0.8s linear 0s infinite normal none running skeleton-loader; }

