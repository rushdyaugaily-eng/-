@keyframes fadein { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.NearStar .AccordionFeatures { display: flex; flex-direction: column; gap: 16px; }

.NearStar .AccordionFeatures * { padding: 0px; margin: 0px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion { border-radius: 6px; border: 1px solid rgb(212, 219, 224); padding-left: 16px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion .ux-collapse-summary, .NearStar .AccordionFeatures .AccordionFeatures-accordion .ux-collapse-reveal { padding: 0px; padding-inline: 0px; margin: 0px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion--selected { padding-right: 16px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion--selected .ux-summary-chevron { opacity: 0; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion--selected .ux-summary-shell[role="button"], .NearStar .AccordionFeatures .AccordionFeatures-accordion--selected .ux-summary-shell[data-version="2400"][role="button"] { cursor: default; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion--selected .ux-summary-shell[role="button"] button, .NearStar .AccordionFeatures .AccordionFeatures-accordion--selected .ux-summary-shell[data-version="2400"][role="button"] button { cursor: default; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion:has([data-open="true"]) { background: radial-gradient(rgb(255, 255, 255), rgb(233, 228, 242)); }

.NearStar .AccordionFeatures .AccordionFeatures-accordion .ux-text-title { margin-bottom: 0px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion .ux-reveal-shell.ux-collapse-reveal[data-open="true"], .NearStar .AccordionFeatures .AccordionFeatures-accordion .ux-reveal-shell[data-version="2400"].ux-collapse-reveal[data-open="true"] { padding-block-start: 0px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion .PlanBox-SectionedList { display: flex; flex-flow: column; gap: 16px; margin-top: 16px; margin-bottom: 40px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion .PlanBox-SectionedList .PlanBox-SectionedListItem { align-items: flex-start; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion .PlanBox-SectionedList .PlanBox-SectionedListItem svg { margin-top: 4px; margin-right: 8px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion img { width: 100%; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion:last-child { margin-bottom: 16px; }

.NearStar .AccordionFeatures .AccordionFeatures-accordion:first-child .PlanBox-SectionedListIcon svg { color: rgb(116, 75, 196); }

.PlanBox-CallOut { background-color: rgb(9, 117, 122); border-radius: 8px 8px 0px 0px; color: rgb(255, 255, 255); height: 39px; left: -1px; margin: 0px; padding: 12px; position: absolute; right: -1px; text-align: center; top: -39px; }

.PlanBox-CallOut-title { margin: 0px; text-transform: uppercase; }

.PlanBox-CallOut-description { margin: 0px; }

.PlanBox-CallOut-icon { margin: 0px 12px 0px 0px; }

.PlanBox-CallOut--withIcon { align-items: center; display: flex; text-align: left; }

.PlanBox-CallOut--premier { background-color: rgb(226, 0, 135); }

.PlanBox-CallOut--callOutMaxHeight { height: 61px; top: -61px; }

.PlanBox-CallOut--free { background-color: rgb(237, 238, 239); color: rgb(17, 17, 17); }

.PlanBox-CallOut--specialBundle { background-color: rgb(116, 75, 196); color: rgb(255, 255, 255); justify-content: center; }

.PlanBox-CallOut--specialBundle .PlanBox-CallOut-title { text-transform: none; font-weight: 700; font-size: 1rem; }

.PlanBox-Selected { background-color: rgb(244, 248, 252); border-radius: 8px 8px 0px 0px; border: 1px solid rgb(214, 214, 214); color: rgb(17, 17, 17); height: 39px; left: -1px; margin: 0px; position: absolute; right: -1px; text-align: center; top: -39px; display: flex; align-items: center; justify-content: center; }

.PlanBox-Selected-Title { margin: 0px; text-transform: uppercase; }

:root, :host { --uxp-icon-plus: url("data:image/svg+xml;utf-8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M20 11.25h-7.25V4a.75.75 0 10-1.5 0v7.25H4a.75.75 0 100 1.5h7.25V20a.75.75 0 101.5 0v-7.25H20a.75.75 0 100-1.5z'/></svg>"); }

