.plan-carousel { position: relative; padding: 16px 0px 40px; }

.plan-carousel__nav { display: flex; align-items: center; justify-content: flex-end; gap: 16px; padding-bottom: 16px; }

.plan-carousel__nav-button.ux-button, .plan-carousel__nav-button.ux-button[data-version="2400"] { border-radius: 50%; background: rgb(255, 255, 255); border: 1px solid rgb(214, 214, 214); color: rgb(17, 17, 17); box-shadow: none; }

.plan-carousel__nav-button.ux-button:hover:not(:disabled), .plan-carousel__nav-button.ux-button[data-version="2400"]:hover:not(:disabled) { border-color: rgb(9, 117, 122); }

.plan-carousel__nav-button.ux-button:disabled, .plan-carousel__nav-button.ux-button[data-version="2400"]:disabled { opacity: 0.4; cursor: not-allowed; }

.plan-carousel__nav-button.ux-button:focus-visible, .plan-carousel__nav-button.ux-button[data-version="2400"]:focus-visible { outline: rgb(0, 164, 166) solid 2px; outline-offset: 2px; }

.plan-carousel__track { display: flex; flex-wrap: nowrap; gap: 16px; overflow-x: auto; scrollbar-width: none; padding-top: 39px; }

.plan-carousel__track::-webkit-scrollbar { display: none; }

.plan-carousel__track > * { --_visible: var(--carousel-visible, 3); --_peek: var(--carousel-peek, 0.3); flex: 0 0 calc((100% - var(--_visible)*16px)/(var(--_visible) + var(--_peek))); min-width: 0px; }

.plan-carousel__viewport { position: relative; }

.plan-carousel__viewport::before, .plan-carousel__viewport::after { content: ""; position: absolute; top: 0px; bottom: 0px; width: 48px; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 200ms; }

.plan-carousel__viewport::before { left: 0px; background: linear-gradient(to right, rgb(255, 255, 255), transparent); }

.plan-carousel__viewport::after { right: 0px; background: linear-gradient(to left, rgb(255, 255, 255), transparent); }

.plan-carousel__viewport--fade-left::before { opacity: 1; }

.plan-carousel__viewport--fade-right::after { opacity: 1; }

@media (min-width: 768px) and (max-width: 1023px) {
  .plan-carousel .plan-carousel__track > * { flex: 0 0 calc(50% - 8px); }
}

@media (max-width: 767px) {
  .plan-carousel { padding: 16px 0px 40px; }
  .plan-carousel .plan-carousel__nav { display: none; }
  .plan-carousel .plan-carousel__track { flex-wrap: wrap; overflow-x: visible; }
  .plan-carousel .plan-carousel__track > * { flex: 0 0 100%; }
}

