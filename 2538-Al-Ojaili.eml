.AllPaidPlansFeatures-title { font-family: "GD Sherpa", Helvetica, Arial, sans-serif; font-size: 26px; font-style: normal; font-weight: 500; line-height: 32px; margin-bottom: 18px; }

.AllPaidPlansFeatures-listItemText { color: rgb(17, 17, 17); font-size: 16px; font-weight: 500; line-height: 20px; margin: 0px 0px 24px; }

.AllPaidPlansFeatures-listItemIcon { height: 17px; width: 17px; }

.AllPaidPlansFeatures-disclaimers { margin: 36px 0px; }

.AllPaidPlansFeatures-disclaimerText { font-size: 14px; line-height: 20px; margin-bottom: 6px; }

.AllPaidPlansFeatures-titlePaywall { font-family: "GD Sherpa", Helvetica, Arial, sans-serif; font-size: 26px; font-style: normal; font-weight: 500; line-height: 32px; margin-bottom: 18px; text-align: center; }

.AllPaidPlansFeatures-mobile { padding: 18px; }

.AllPaidPlansFeatures-mobile .AllPaidPlansFeatures-list { display: flex; flex-wrap: wrap; justify-content: space-between; }

.AllPaidPlansFeatures-mobile .AllPaidPlansFeatures-listItem { margin-bottom: 21px; width: 45%; }

.AllPaidPlansFeatures-desktop .AllPaidPlansFeatures-list { display: inline-grid; grid-template-columns: 0.4fr 0.5fr 0.6fr 1fr; width: 100%; }

.AllPaidPlansFeatures-desktop .AllPaidPlansFeatures-listItem { display: flex; margin: 0px 20px 0px 0px; }

.AllPaidPlansFeatures-desktop .AllPaidPlansFeatures-listItem:last-child { margin-right: 0px; }

.AllPaidPlansFeatures-desktop .AllPaidPlansFeatures-listItemText { display: inline-block; vertical-align: super; }

.AllPaidPlansFeatures-desktop .AllPaidPlansFeatures-listItemIcon { margin-right: 16px; }

.discountBadge { margin: 0px 0px 0px 8px; }

.discountBadge > span { font-weight: bold; font-size: 14px; -webkit-font-smoothing: antialiased; text-transform: uppercase; background: rgb(255, 238, 169); padding: 4px; font-family: "GD Sherpa", Helvetica, Arial, sans-serif; }

.pu-carousel-container { margin: 0px 16px; }

.pu-carousel { display: flex; overflow-x: auto; }

.pu-carousel .pu-carousel-item-tag-container { display: flex; flex-direction: row; align-items: center; gap: 4.8px; border-radius: 4px; padding: 4px 6px; margin: 0px; width: fit-content; }

.pu-carousel .pu-carousel-item-tag-container .icon svg.uxicon-svg-container { height: 20px; width: 20px; }

.pu-carousel .pu-carousel-item-tag-container--purple-gradient { background: linear-gradient(90deg, rgb(233, 228, 242) 0%, rgb(218, 205, 246) 100%); }

.pu-carousel .pu-carousel-item-tag-container--purple-gradient .icon { color: rgb(116, 75, 196); }

.pu-carousel-title { margin-bottom: 8px; text-align: center; }

.pu-carousel-item { align-items: center; background-color: rgb(245, 247, 248); border-radius: 6px; display: flex; margin-right: 12px; padding: 16px 18px; white-space: nowrap; }

.pu-carousel-item:last-of-type { margin-right: 0px; }

.pu-carousel-item--excluded { opacity: 0.5; }

.pu-carousel-item--excluded .pu-bordered-icon { border-color: rgb(118, 118, 118); color: rgb(118, 118, 118); }

.pu-carousel-item-highlight-text { background-color: rgb(255, 238, 169); text-transform: uppercase; padding: 2px 4px; }

.pu-carousel-item-text-container { align-items: center; display: flex; flex-wrap: wrap; }

.pu-carousel-item-text-container > p { font-weight: 700 !important; margin-bottom: 0px; }

.pu-carousel-indicator-container { display: flex; justify-content: center; margin-top: 8px; margin-bottom: 24px; }

.pu-carousel-indicator { align-items: center; color: rgb(200, 200, 200); display: flex; font-size: 24px; height: 24px; justify-content: center; width: 24px; }

.pu-carousel-indicator--selected { color: rgb(17, 17, 17); }
