@keyframes fadein { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes loadingOverlay { 
  0% { background-position: 100% 100%; opacity: 0.6; }
  50% { opacity: 1; }
  100% { background-position: -50% -50%; opacity: 0.6; }
}

.pu-bordered-icon { align-items: center; border: 1px solid rgb(213, 219, 223); border-radius: 4px; display: flex; justify-content: center; margin-right: 8px; padding: 5px; }

.pu-premiumtag { align-items: center; color: rgb(226, 0, 135); display: inline-flex; justify-content: center; margin-bottom: 16px; }

.pu-premiumtag .pu-premiumtag-text { font-weight: 500; margin: 0px 0px 0px 6px; text-transform: uppercase; }

.pu-tooltip { align-items: center; cursor: pointer; display: flex; justify-content: center; }

.pu-tooltip-content { max-width: 300px; }

.pu-tooltip-title { font-weight: bold !important; margin-bottom: 8px; }

.pu-tooltip-text { margin-bottom: 0px; }

.pu-tooltip-tooltip { z-index: 1; }

.ux-tag-airo.ux-tag--design-filled { --ux-tag-fill-color: #d3c1f7; --ux-tag-content-color: #111; background-color: rgb(211, 193, 247); color: rgb(17, 17, 17); }

.pu-tabs { display: flex; flex-direction: column; width: 100%; position: relative; }

.pu-tabs-sentinel { height: 1px; width: 100%; visibility: hidden; pointer-events: none; }

.pu-tabs-header { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 16px; background-color: rgb(255, 255, 255); padding-top: 24px; }

.pu-tabs-header * { margin: 0px; }

.pu-tabs-header--stuck { position: sticky; top: 0px; z-index: 1; }

.pu-tabs-header--stuck .pu-tabs-list { box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 0px, rgba(0, 0, 0, 0.1) 0px 4px 3px 0px, rgba(0, 0, 0, 0.07) 0px 2px 1px; border-bottom: 0px; }

.pu-tabs-list { display: flex; flex-direction: row; align-items: stretch; isolation: isolate; list-style: none; margin: 0px; padding: 0px; width: 100%; border-bottom: 1px solid rgb(212, 219, 224); }

@media (max-width: 768px) {
  .pu-tabs-list { flex-direction: column; }
}

.pu-tabs-list-item { display: flex; flex: 1 1 0px; margin: 0px; min-width: 0px; }

.pu-tabs-tab { align-items: center; appearance: none; background-color: rgb(245, 247, 248); border-width: 1px 1px 0px; border-top-style: solid; border-right-style: solid; border-left-style: solid; border-top-color: rgb(212, 219, 224); border-right-color: rgb(212, 219, 224); border-left-color: rgb(212, 219, 224); border-image: initial; border-bottom-style: initial; border-bottom-color: initial; border-radius: 16px 16px 0px 0px; box-sizing: border-box; color: rgb(17, 17, 17); cursor: pointer; display: flex; flex: 1 1 0%; flex-direction: column; font-family: "GD Sherpa", Helvetica, Arial, sans-serif; gap: 8px; justify-content: center; min-height: 84px; padding: 16px 40px; position: relative; text-align: center; width: 100%; z-index: 1; }

.pu-tabs-tab:focus-visible { outline: rgb(9, 117, 122) solid 2px; outline-offset: -2px; }

.pu-tabs-tab--selected { background-color: rgb(255, 255, 255); border-color: rgb(9, 117, 122); border-top-width: 5px; padding-top: 12px; z-index: 2; }

.pu-tabs-tab-header { align-items: center; display: flex; flex-flow: wrap; gap: 8px; justify-content: center; }

.pu-tabs-tab-icon { align-items: center; display: inline-flex; flex-shrink: 0; line-height: 0; }

.pu-tabs-tab-icon svg { display: block; height: 22px; width: 22px; }

.pu-tabs-tab-title { color: rgb(17, 17, 17); font-size: 1rem; font-weight: 700; line-height: 1.36; margin: 0px; white-space: nowrap; }

.pu-tabs-tab-subtitle { color: rgb(97, 103, 121); font-size: 0.875rem; font-weight: 400; line-height: 1.5; margin: 0px; max-width: 100%; }

.pu-tabs-tab-content { width: 100%; }

.pu-tabs-tab-content[hidden] { display: none; }

.NearStar .pu-option-selector-option-container { background-color: rgb(255, 255, 255); border-radius: 8px; border: 1px solid rgb(212, 219, 224); box-sizing: border-box; cursor: pointer; margin-bottom: 8px; padding: 16px 24px; transition: background-color 250ms ease-in-out; }

.NearStar .pu-option-selector-option-container:hover { background-color: rgb(245, 247, 248); }

.NearStar .pu-option-selector-option-container:last-child { margin-bottom: 0px; }

.NearStar .pu-option-selector-option-container.pu-selected-option { border-color: rgb(27, 219, 219); border-width: 2px; padding: 15px 23px; }

.NearStar .pu-option-selector-option-container.pu-disabled-option { cursor: not-allowed; opacity: 0.4; transition: opacity 250ms ease-in-out; }

.NearStar .pu-option-selector-option-container .pu-option-description { align-items: center; display: flex; }

.NearStar .pu-option-selector-option-container .pu-option-description-text { font-weight: 700; margin: 0px 8px 0px 0px; }

.NearStar .pu-option-selector-option-container .pu-option-details-text { margin: 8px 0px 0px; }

.NearStar .pu-option-selector-option-container .pu-radio-button, .NearStar .pu-option-selector-option-container .pu-label-container { align-items: center; display: flex; justify-content: space-between; }

.NearStar .pu-option-selector-option-container .pu-option-label { margin-bottom: 0px; }

.NearStar .pu-option-selector-option-container .pu-radio-button label { margin-left: 12px; }

