.uxicon-minus::before { content: var(--uxp-icon-minus); }

.PlanBox-featuresGroupHeader { margin: 1rem 0px 0.5rem; display: block; font-weight: var(--ux-1a9e4a3, 700) !important; }

.PlanBox-featureListTitle { margin: 0px 0px 8px; }

.PlanBox-featureList { list-style-type: none; margin: 0px; padding: 0px; }

.PlanBox-featureList--bold { font-weight: 900; }

.PlanBox-featureItem { align-items: flex-start; display: flex; margin: 8px 0px; }

.PlanBox-featureListSeeMoreButtton { display: flex; align-items: center; padding-top: 9px; }

.PlanBox-featureItemTooltip svg { margin-left: 3px; vertical-align: text-bottom; }

.PlanBox-featureItemBox { display: inline-flex; }

.PlanBox-featureItemBox--featureItemText { display: inline; }

.PlanBox-featureHighlightTag { background: rgb(166, 255, 248); border-radius: 0.25rem; color: rgb(0, 66, 73); font-size: 0.75rem; font-weight: bold; letter-spacing: 0.9px; line-height: 0.75rem; margin-left: 0.5rem; padding: 0.25rem; text-transform: uppercase; }

.PlanBox-featureItem--comingSoon { color: rgb(68, 68, 68); font-weight: 200; }

.PlanBox-featureItem--comingSoon .PlanBox-featureItem--featureItemText.ux-text-paragraph { color: rgb(68, 68, 68); font-weight: 200; }

.PlanBox-featureComingSoonIcon { color: rgb(68, 68, 68); }

.PlanBox-bulletIcon { background-color: rgb(0, 0, 0); border-radius: 50%; display: inline-block; height: 5px; margin: 8px; width: 5px; flex: 0 0 5px; }

.PlanBox-SectionedListItem { align-items: flex-start; display: flex; margin-bottom: 8px; }

.PlanBox-SectionedListIcon { display: flex; margin-right: 8px; margin-top: 4px; color: rgb(68, 68, 68); }

.PlanBox-SectionedListIcon:empty::before { content: ""; background-color: currentcolor; border-radius: 50%; display: inline-block; height: 4px; width: 4px; flex: 0 0 4px; }

.PlanBox-SectionedList h3 { font-size: 0.875rem; font-weight: var(--ux-1a9e4a3, 700); margin: 0px 0px 0.5rem; }

.PlanBox-SectionedListTooltip svg { margin-left: 3px; vertical-align: text-bottom; }

@media screen and (min-width: 768px) {
  .PlanBox-SectionedList { margin-bottom: 32px; }
}

.PlanBox--aabMerchNewUx .PlanBox-featureItem { align-items: center; gap: 8px; }

.PlanBox--aabMerchNewUx .PlanBox-featureItem > svg { flex: 0 0 20px; height: 20px; width: 20px; }

.PlanBox--aabMerchNewUx .PlanBox-featureItemBox { display: inline-block; }

.PlanBox--aabMerchNewUx .PlanBox-featureCheckIcon { color: var(--ux-1leynsm, black); }

.PlanBox--aabMerchNewUx .PlanBox-featureListTitle:not(:first-child) { margin-top: 24px; }

.PlanBox-KeyFeature-Section { padding: 8px 4px; }

.PlanBox-KeyFeature-Container { align-items: center; display: flex; justify-content: center; position: relative; width: 100%; }

.PlanBox-KeyFeature-Line { background: rgb(0, 164, 166); height: 1px; width: 100%; }

.PlanBox-KeyFeature-Content { align-items: center; inset: 50% 0px 0px; color: rgb(0, 164, 166); display: flex; justify-content: center; margin: 0px auto; position: absolute; text-align: center; }

.PlanBox-KeyFeature-Text { background-color: rgb(255, 255, 255); display: flex; justify-content: center; padding: 4px 10px; }

.PlanBox-KeyFeature-Title { height: inherit; letter-spacing: 0.9px; margin-left: 10px; text-transform: uppercase; }

.PlanBox-grid-item--prices { margin-top: 16px; }

.PlanBox-priceContainer { height: 40px; margin: 0px; position: relative; }

.PlanBox-mainPriceContainer { align-items: baseline; display: flex; position: absolute; opacity: 0; transition: opacity 350ms ease-in-out; }

.PlanBox-mainPriceContainer--show { opacity: 1; }

.PlanBox-mainPrice { margin: 0px; line-height: 100%; }

.PlanBox-mainPriceSuffix { margin: 0px 0px 0px 4px; }

.PlanBox-altPriceContainer { align-items: center; justify-content: flex-start; gap: 8px; display: flex; flex-wrap: wrap; }

.PlanBox-altPriceContainer--noDisplay { display: none; }

.PlanBox-altPrice { margin: 0px; opacity: 1; transition: opacity 350ms ease-in-out; }

.PlanBox-altPrice--strikethrough { text-decoration: line-through; }

.PlanBox-altPrice--invisible { opacity: 0; pointer-events: none; }

.PlanBox-mainPriceTooltip svg { margin-left: 3px; vertical-align: text-bottom; }

.PlanBox-altPriceTooltip { margin-right: 8px; opacity: 1; transition: opacity 350ms ease-in-out; }

.PlanBox-altPriceTooltip svg { margin-left: 3px; vertical-align: text-bottom; }

.PlanBox-altPriceTooltip--invisible { opacity: 0; pointer-events: none; }

